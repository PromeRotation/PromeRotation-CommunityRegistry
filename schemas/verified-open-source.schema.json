{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PromeRotation/PromeRotation-CommunityRegistry/main/schemas/verified-open-source.schema.json",
  "title": "PromeRotation Verified Open Source Registry",
  "description": "Verified source repository and manifest catalog bindings for PromeRotation ACRs or plugins.",
  "type": "object",
  "required": [
    "schemaVersion",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "$ref": "#/$defs/verifiedEntry"
      }
    }
  },
  "$defs": {
    "verifiedEntry": {
      "type": "object",
      "required": [
        "bindings"
      ],
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/verifiedBinding"
          }
        }
      }
    },
    "verifiedBinding": {
      "type": "object",
      "required": [
        "repositoryUrl",
        "catalogUrls"
      ],
      "additionalProperties": false,
      "properties": {
        "repositoryUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "catalogUrls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
